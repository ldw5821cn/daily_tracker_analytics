[Unit]
Description=Hermes ETF Daily Report
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/home/liudawei/github/daily_tracker_analytics
Environment="PATH=/home/liudawei/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/liudawei/.hermes/scripts/etf_report_with_retry.sh
