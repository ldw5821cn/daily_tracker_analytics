# ═══════════════════════════════════════════
# API Keys 模板 — 复制为 .env 并填入真实值
# ═══════════════════════════════════════════

# TickFlow 实时行情API (api.tickflow.org)
# 前往 https://tickflow.org 注册获取
TICKFLOW_API_KEY=your_tickflow_api_key

# Tushare 数据源 (tushare.pro)
# 前往 https://tushare.pro 注册获取 token
TUSHARE_TOKEN=your_tushare_token

# 雪球组合 GID（必填）
# 组合页面URL中 gid= 后面的数字
XUEQIU_GID=your_xueqiu_gid

# 微信推送 token（可选，Hermes Web UI 配置）
# HERMES_WEIXIN_TOKEN=your_weixin_token
